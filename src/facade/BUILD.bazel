"""Bazel/rules_oci build for the facade image.

Follows rules_oci's Python guide (aspect-build/bazel-examples/oci_python_image),
the same as the orchestration worker at //src/orchestration: an
aspect_rules_py py_binary -- launched from a venv over rules_python's hermetic
interpreter and the pinned @pip wheels -- split by py_image_layer into
interpreter, site-packages and app layers, onto plain Ubuntu. The image has no
Python besides the one in the runfiles. Bazel is the only build: there is no
Containerfile.
"""

load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_image_layer", "py_library")
load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@pip//:requirements.bzl", "requirement")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")

package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "facade_lib",
    srcs = [
        "__init__.py",
        "dependencies.py",
        "main.py",
        "schemas.py",
        "service.py",
        "utils.py",
    ],
    imports = [".."],
    deps = [
        requirement("aioboto3"),
        # aioboto3 imports boto3.session directly at module load time
        # (it wraps boto3.Session with the aiobotocore async backend) --
        # rules_python's pip-parsed targets don't auto-wire a package's
        # extras-only sub-dependencies (aioboto3's actual pin is
        # `aiobotocore[boto3]==2.25.1`, an extra, not a plain `boto3`
        # requirement) into the dependency graph, so it needs listing
        # explicitly even though nothing here imports it directly.
        requirement("boto3"),
        requirement("fastapi"),
        requirement("httpx"),
        requirement("pydantic-settings"),
        requirement("python-multipart"),
        requirement("redis"),
        requirement("uvicorn"),
    ],
)

py_binary(
    name = "serve",
    srcs = ["serve.py"],
    imports = [".."],
    main = "serve.py",
    deps = [":facade_lib"],
)

# The base image's unprivileged `ubuntu` user (uid/gid 1000). The facade runs
# as it, and owns its runfiles: the launcher creates the binary's venv inside
# them on every start.
UBUNTU_UID = "1000"

py_image_layer(
    name = "layers",
    binary = ":serve",
    group = UBUNTU_UID,
    owner = UBUNTU_UID,
    platform = "//tools/platforms:linux_x86_64",
)

oci_image(
    name = "image",
    base = "@ubuntu",
    entrypoint = ["/src/facade/serve"],
    exposed_ports = ["8000/tcp"],
    tars = [":layers"],
    user = "ubuntu",
)

platform_transition_filegroup(
    name = "transitioned_image",
    srcs = [":image"],
    target_platform = "//tools/platforms:linux_x86_64",
)

container_structure_test(
    name = "structure_test",
    configs = ["//src/facade/tests/structural:structure_test.yaml"],
    image = ":transitioned_image",
)

# bazel run //src/facade:tarball
# loads the facade image into the local Docker daemon as:
#   docling-serve-ray-facade:bazel
#   docling-serve-ray-facade:latest
oci_load(
    name = "tarball",
    image = ":transitioned_image",
    repo_tags = [
        "docling-serve-ray-facade:bazel",
        "docling-serve-ray-facade:latest",
    ],
)

# bazel run //src/facade:push
# Pushes to GHCR -- run in CI only (see .github/workflows/ci.yml's
# push-images job), after tests pass, on push to main.
oci_push(
    name = "push",
    image = ":transitioned_image",
    remote_tags = ["latest"],
    repository = "ghcr.io/k-sparrow/docling-serve-ray-facade",
)
